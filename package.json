{
  "name": "lixionary-whistleblower",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm suite:dev",
    "dev:server": "pnpm --filter @whistle/server dev",
    "dev:web": "pnpm --filter @whistle/web dev",
    "build": "pnpm version:check && pnpm --filter @whistle/shared build && pnpm --filter @whistle/runtime build && pnpm --filter @whistle/server build && pnpm --filter @whistle/privacy build && pnpm --filter @whistle/web build",
    "typecheck": "pnpm version:check && pnpm -r typecheck",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync",
    "version:bump": "node scripts/version.mjs",
    "test:version": "node --test scripts/test/version.test.mjs",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @whistle/server db:migrate",
    "admin:create": "pnpm --filter @whistle/server admin:create",
    "suite:setup": "node scripts/setup-suite.mjs",
    "suite:dev": "pnpm storage:setup && docker compose --env-file .suite-dev/suite.env --profile development up --build -d",
    "test:integration": "pnpm --filter @whistle/server test",
    "test:browser": "pnpm --filter @whistle/web exec playwright test",
    "dev:privacy": "pnpm --filter @whistle/privacy dev",
    "deploy:vps": "node scripts/deploy-vps.mjs",
    "email:configure:vps": "node scripts/configure-zoho-vps.mjs",
    "test:deploy": "node --test scripts/test/*.test.mjs",
    "storage:setup": "bash scripts/setup-storage.sh",
    "test:storage": "node scripts/test-storage.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
