# Compose configuration is generated by `pnpm suite:setup` into .suite-dev/suite.env.
# Production: SUITE_CONFIG_DIR=.suite-config SUITE_DOMAIN=reports.example.com \
#   node scripts/setup-suite.mjs --production
# Secrets belong in the generated protected files, never inline in this template.
SUITE_CONFIG_DIR=.suite-config
SUITE_DOMAIN=reports.example.com
PUBLIC_WEB_URL=https://reports.example.com
# Optional administrator development tracker; empty URL disables Jira.
JIRA_URL=
JIRA_PROJECT_KEY=LWB
JIRA_CLIENT_ID=
# Direct API development: set JIRA_CLIENT_SECRET_FILE to a protected file.
# Compose mounts SUITE_CONFIG_DIR/secrets/jira_client_secret into the case API.
STAFF_GOOGLE_CLIENT_ID=
# Direct API development: use STAFF_GOOGLE_CLIENT_SECRET_FILE for the protected secret file.
# Compose mounts SUITE_CONFIG_DIR/secrets/staff_google_client_secret automatically.
SUITE_NODE_ENV=production
STAFF_SMTP_HOST=
STAFF_SMTP_PORT=587
STAFF_SMTP_USER=
STAFF_SMTP_FROM=Speak Up <no-reply@example.com>
PRIVACY_SMTP_HOST=
PRIVACY_SMTP_PORT=587
PRIVACY_SMTP_USER=
PRIVACY_SMTP_FROM=Speak Up <no-reply@example.com>
TWILIO_FROM=
RESTIC_REPOSITORY=

# Direct privacy-service development (Compose supplies these automatically).
PRIVACY_EVIDENCE_BACKEND=s3
PRIVACY_S3_ENDPOINT=http://garage:3900
PRIVACY_S3_REGION=garage
PRIVACY_S3_BUCKET=whistle-evidence
# PRIVACY_S3_ACCESS_KEY_FILE and PRIVACY_S3_SECRET_KEY_FILE point to protected files.
